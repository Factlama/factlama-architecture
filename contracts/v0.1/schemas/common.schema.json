{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factlama.dev/contracts/v0.1/common.schema.json",
  "title": "FactLama v0.1 shared definitions",
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "description": "major.minor. Unknown major MUST be rejected; unknown minor within a known major MAY be accepted (additive).",
      "pattern": "^0\\.[0-9]+$"
    },
    "OpaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Timestamp": {
      "type": "string",
      "description": "RFC 3339 UTC timestamp (Z suffix required).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "VerificationMode": {
      "type": "string",
      "enum": ["FAST", "STANDARD", "DEEP"]
    },
    "ClaimVerdict": {
      "type": "string",
      "enum": ["SUPPORTED", "CONTRADICTED", "UNSUPPORTED", "INSUFFICIENT_EVIDENCE", "NOT_APPLICABLE", "DISPUTED"]
    },
    "OverallVerdict": {
      "type": "string",
      "enum": ["PASS", "PARTIAL", "FAIL", "ABSTAIN", "DISPUTED"]
    },
    "ResultStatus": {
      "type": "string",
      "enum": ["COMPLETED", "ABSTAINED", "FAILED", "DISPUTED"]
    },
    "AbstentionReason": {
      "type": "string",
      "enum": [
        "NO_CHECKABLE_CLAIMS",
        "INSUFFICIENT_EVIDENCE",
        "PROVIDER_FAILURE",
        "BUDGET_EXHAUSTED",
        "NO_COMPLIANT_PROVIDER",
        "REVOKED",
        "CANCELLED"
      ]
    },
    "DisputeReason": {
      "type": "string",
      "enum": ["JUDGE_DISAGREEMENT"]
    },
    "RationaleCode": {
      "type": "string",
      "description": "Short, stable, versioned tag. v0.1 vocabulary per CONTRACTS.md; additive only.",
      "enum": [
        "DIRECT_SUPPORT",
        "PARAPHRASED_SUPPORT",
        "CONTRADICTION_DETECTED",
        "NUMERICAL_CONTRADICTION",
        "NO_SUPPORT",
        "NO_EVIDENCE_SUPPLIED",
        "AMBIGUOUS_EVIDENCE",
        "CITATION_UNSUPPORTED",
        "PROVIDER_DISPATCH_FAILED",
        "NOT_APPLICABLE_CLAIM_TYPE",
        "JUDGE_DISAGREEMENT"
      ]
    },
    "TextStatus": {
      "type": "string",
      "enum": ["AVAILABLE", "REDACTED", "NOT_STORED"]
    },
    "ScoreStatus": {
      "type": "string",
      "enum": ["MEASURED", "NOT_APPLICABLE", "UNAVAILABLE"]
    },
    "QualificationStatus": {
      "type": "string",
      "description": "Per-attempt qualification. Never MIXED -- one attempt is one provider's actual status.",
      "enum": ["QUALIFIED", "PROVISIONAL", "UNQUALIFIED"]
    },
    "QualificationStatusOrMixed": {
      "type": "string",
      "description": "Event-level qualification, which may span attempts of differing status.",
      "enum": ["QUALIFIED", "PROVISIONAL", "UNQUALIFIED", "MIXED"]
    },
    "AttemptOutcome": {
      "type": "string",
      "enum": ["COMPLETED", "FAILED"]
    },
    "JudgeErrorCode": {
      "type": "string",
      "enum": [
        "TIMEOUT",
        "RATE_LIMIT",
        "UNAVAILABLE",
        "INVALID_RESPONSE",
        "CANCELLED",
        "CONFIGURATION",
        "BUDGET_EXHAUSTED",
        "NO_COMPLIANT_PROVIDER",
        "REVOKED"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "CostStatus": {
      "type": "string",
      "enum": ["MEASURED", "UNAVAILABLE"]
    },
    "Cost": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/CostStatus" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "pricing_version": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "MEASURED" } } },
      "then": { "required": ["status", "amount", "currency"] }
    },
    "Usage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost": { "$ref": "#/$defs/Cost" },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "ScoreValue": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "$ref": "#/$defs/ScoreStatus" },
        "method_version": { "type": "string" },
        "calibration_class": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "MEASURED" } } },
      "then": { "required": ["status", "value", "method_version", "calibration_class"] },
      "else": { "not": { "required": ["value"] } }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["evidence_id"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/OpaqueId" },
        "content": { "type": "string" },
        "reference": { "type": "object", "additionalProperties": true },
        "source_uri": { "type": "string" },
        "title": { "type": "string" },
        "retrieval_rank": { "type": "integer", "minimum": 0 },
        "retrieval_score": { "type": "number" },
        "timestamp": { "$ref": "#/$defs/Timestamp" },
        "trust_label": { "type": "string" }
      },
      "oneOf": [
        { "required": ["content"], "not": { "required": ["reference"] } },
        { "required": ["reference"], "not": { "required": ["content"] } }
      ]
    },
    "Claim": {
      "type": "object",
      "additionalProperties": true,
      "required": ["claim_id", "text"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/OpaqueId" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "Citation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["citation_id", "evidence_id"],
      "properties": {
        "citation_id": { "$ref": "#/$defs/OpaqueId" },
        "claim_id": { "$ref": "#/$defs/OpaqueId" },
        "evidence_id": { "$ref": "#/$defs/OpaqueId" }
      }
    },
    "ToolExecution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tool_execution_id", "tool_name", "status"],
      "properties": {
        "tool_execution_id": { "$ref": "#/$defs/OpaqueId" },
        "tool_name": { "type": "string" },
        "status": { "type": "string", "enum": ["SUCCESS", "ERROR", "TIMEOUT"] },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "completed_at": { "$ref": "#/$defs/Timestamp" },
        "error_message": { "type": "string" }
      }
    },
    "Instruction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["instruction_id", "text"],
      "properties": {
        "instruction_id": { "$ref": "#/$defs/OpaqueId" },
        "text": { "type": "string" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] }
      }
    },
    "ContributingJudgment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["attempt_id", "verdict", "evidence_ids", "rationale_code"],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/OpaqueId" },
        "verdict": { "$ref": "#/$defs/ClaimVerdict" },
        "evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/OpaqueId" } },
        "rationale_code": { "$ref": "#/$defs/RationaleCode" }
      }
    },
    "ClaimResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["claim_id", "verdict", "evidence_ids", "rationale_code", "text_status", "contributing_judgments"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/OpaqueId" },
        "verdict": { "$ref": "#/$defs/ClaimVerdict" },
        "evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/OpaqueId" } },
        "rationale_code": { "$ref": "#/$defs/RationaleCode" },
        "rationale": { "type": "string" },
        "text_status": { "$ref": "#/$defs/TextStatus" },
        "text": { "type": "string" },
        "contributing_judgments": { "type": "array", "items": { "$ref": "#/$defs/ContributingJudgment" } }
      },
      "if": { "properties": { "verdict": { "const": "SUPPORTED" } } },
      "then": { "properties": { "evidence_ids": { "type": "array", "minItems": 1 } } }
    },
    "Violation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "severity", "claim_ids", "evidence_ids"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/Severity" },
        "claim_ids": { "type": "array", "items": { "$ref": "#/$defs/OpaqueId" } },
        "evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/OpaqueId" } },
        "message": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "attempt_id",
        "provider_id",
        "configuration_version",
        "qualification_status",
        "calibration_class",
        "outcome",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/OpaqueId" },
        "provider_id": { "type": "string" },
        "model_id": { "type": "string" },
        "pinned_model_version": { "type": "string" },
        "configuration_version": { "type": "string" },
        "qualification_status": { "$ref": "#/$defs/QualificationStatus" },
        "calibration_class": { "type": "string" },
        "outcome": { "$ref": "#/$defs/AttemptOutcome" },
        "error": { "$ref": "#/$defs/JudgeErrorCode" },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "completed_at": { "$ref": "#/$defs/Timestamp" },
        "usage": { "$ref": "#/$defs/Usage" }
      },
      "if": { "properties": { "outcome": { "const": "FAILED" } } },
      "then": { "required": ["error"] }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["evaluator_id", "evaluator_version", "mode", "routing_profile_version", "started_at", "completed_at", "attempts"],
      "properties": {
        "evaluator_id": { "type": "string" },
        "evaluator_version": { "type": "string" },
        "policy_version": { "type": ["string", "null"] },
        "mode": { "$ref": "#/$defs/VerificationMode" },
        "routing_profile_version": { "type": "string" },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "completed_at": { "$ref": "#/$defs/Timestamp" },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/Attempt" } }
      }
    }
  }
}
